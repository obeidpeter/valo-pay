    "/v1/records/{kind}": {
      "get": {
        "operationId": "listRecords",
        "tags": [
          "valopay"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "merchantId",
            "in": "query",
            "required": true,
