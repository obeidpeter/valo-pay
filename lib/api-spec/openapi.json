  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "integer"
          },
          "scheduler": {
            "$ref": "#/components/schemas/SchedulerStatus"
          }
        },
        "required": [
          "status",
          "build",
          "startedAt",
          "uptimeSeconds",
          "scheduler"
        ]
      },
      "SchedulerRun": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer"
          },
          "initialised": {
            "type": "integer"
          },
          "examined": {
            "type": "integer"
          },
          "closed": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        },
        "required": [
          "runId",
          "at",
          "durationMs",
          "initialised",
          "examined",
          "closed",
          "skipped",
          "failed"
        ]
      },
      "SchedulerStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_started",
              "running",
              "off",
              "stopped"
            ]
          },
          "intervalMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ticks": {
            "type": "integer"
          },
          "lastTickAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastRun": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SchedulerRun"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "state",
          "intervalMs",
          "ticks",
          "lastTickAt",
          "lastRun"
        ]
      },
      "DatabaseCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed"
            ]
          },
          "latencyMs": {
            "type": "integer"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "ReadinessStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "build": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/DatabaseCheck"
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "build",
          "checks"
        ]
      },
      "RecordData": {
        "type": "object",
        "additionalProperties": {}
      },
      "ValopayRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "amountKobo": {
            "type": "integer"
          },
          "customerId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RecordData"
          }
        },
        "required": [
          "id",
          "merchantId",
          "kind",
          "name",
          "status",
          "reference",
          "amountKobo",
          "customerId",
          "createdAt",
          "updatedAt",
          "data"
        ]
      },
      "RecordInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "amountKobo": {
            "type": "integer",
            "minimum": 0
          },
          "customerId": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RecordData"
          }
        },
        "required": [
          "name"
        ]
      },
      "RecordUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "amountKobo": {
            "type": "integer",
            "minimum": 0
          },
          "customerId": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RecordData"
          }
        },
        "required": []
      },
      "Merchant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "monthlyVolume": {
            "type": "integer"
          },
          "killSwitch": {
            "type": "boolean"
          },
          "preDataReady": {
            "type": "boolean"
          },
          "preLiveReady": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "shortName",
          "segment",
          "mode",
          "status",
          "provider",
          "monthlyVolume",
          "killSwitch",
